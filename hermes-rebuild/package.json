{
  "name": "hermes-learning-os",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev:web": "pnpm --dir apps/web dev",
    "build:web": "pnpm --dir apps/web build",
    "test:web": "pnpm --dir apps/web test",
    "typecheck:web": "pnpm --dir apps/web typecheck",
    "contracts:generate": "node scripts/contracts.mjs",
    "contracts:check": "node scripts/contracts.mjs --check"
  },
  "devDependencies": {
    "openapi-typescript": "7.13.0"
  }
}
