# Development only. Copy to .env in apps/api; never commit actual credentials.
HERMES_ENVIRONMENT=development
HERMES_DATABASE_URL=sqlite:///./hermes-development.db
HERMES_ALLOWED_ORIGIN=http://127.0.0.1:5173
HERMES_COOKIE_SECURE=false
HERMES_ATTACHMENT_STORAGE=local
HERMES_ATTACHMENT_LOCAL_ROOT=./.local/attachments

# 单用户模式（自用 / 本机部署）：没有会话时自动以库里唯一用户身份建立登录会话，
# 打开即是书房，不需要输账号密码。鉴权、owner 隔离、CSRF 全部照旧。
# 生产环境禁止开启（Settings 会直接报错），避免把公网部署变成无鉴权。
# HERMES_SINGLE_USER_MODE=true

# Production requires PostgreSQL, HTTPS, secure cookies and storage=s3.
# Supply AWS credentials through the normal runtime identity/credential chain.
# A bucket must deny public access; verify its policy in the deployment environment.
# HERMES_ATTACHMENT_S3_BUCKET=your-private-bucket
# HERMES_ATTACHMENT_S3_REGION=your-region
# HERMES_ATTACHMENT_S3_ENDPOINT=https://your-s3-compatible-service
