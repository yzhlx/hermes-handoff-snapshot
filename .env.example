# Hermes Cloud Core V1 — example environment file (PLACEHOLDERS ONLY).
# Copy to `.env` and fill real values from your secret manager. `.env` is git-ignored.
# NEVER commit real values. The service refuses to start in production without HERMES_SECRET_KEY.

HERMES_ENV=production
HERMES_SECRET_KEY=replace-me
HERMES_DB_PATH=/data/hermes_cloud.db
HERMES_BIND_HOST=0.0.0.0
HERMES_PORT=8080

# AI provider (key is env/secret-manager only; never in code, DB, logs, or responses)
PROVIDER_BASE_URL=https://your-provider.example.com/v1
PROVIDER_API_KEY=replace-me
PROVIDER_MODEL=replace-me

# One-time admin bootstrap token (used with --bootstrap-admin)
ADMIN_INIT_TOKEN=replace-me

# Host data directory for the cloud DB (bind-mounted to /data in the container).
# Production default is /var/lib/hermes-cloud; override with a temp dir for tests.
HERMES_DATA_DIR=/var/lib/hermes-cloud

# Mock provider (deterministic, no real network/key). OFF in production (0).
# Set to 1 ONLY for isolated package-repair / CI smoke runs.
HERMES_MOCK_PROVIDER=0
